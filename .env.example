# Copy this file to ".env" and fill in your own keys. Never commit ".env".

# Option A (best): Google Cloud Vision API key. Gives a confidence score per word.
GOOGLE_VISION_API_KEY=

# Option B: Gemini API key (Google AI Studio). Used for OCR if no Vision key,
# and for the optional "general information" section.
GEMINI_API_KEY=

# auto = Vision if its key exists, otherwise Gemini.  Or force: vision / gemini
OCR_PROVIDER=auto

# Model name used for Gemini calls (change if Google retires this one)
GEMINI_MODEL=gemini-2.5-flash

# Words with OCR confidence below this are marked as uncertain (0 to 1)
LOW_CONFIDENCE_THRESHOLD=0.80

# Optional AI-written "general information" about each confirmed medicine
ENABLE_GENERAL_INFO=true

MAX_UPLOAD_MB=5
